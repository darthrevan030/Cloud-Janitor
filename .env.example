# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your actual keys.

# ── LLM Configuration ──────────────────────────────────────────────────
# The default endpoint is OpenRouter. For enterprise deployments, override
# with your own Bedrock/Azure-OpenAI/vLLM endpoint for zero third-party egress.

# Required: API key for the LLM endpoint.
# JANITOR_LLM_API_KEY takes precedence; falls back to OPENROUTER_API_KEY.
OPENROUTER_API_KEY=sk-or....
# JANITOR_LLM_API_KEY=sk-or....

# Optional: override the LLM API base URL (BYO-endpoint)
# Default: https://openrouter.ai/api/v1
# Examples:
#   JANITOR_LLM_BASE_URL=https://your-bedrock-proxy.internal/v1
#   JANITOR_LLM_BASE_URL=https://your-azure-openai.openai.azure.com/openai/deployments/gpt-4/
# JANITOR_LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional: override the default LLM model
# Default: anthropic/claude-haiku-4-5
# JANITOR_LLM_MODEL=anthropic/claude-haiku-4-5

# Optional: disable all AI features (kill switch — nothing leaves the network)
# Set to "false" to disable all LLM calls; agents return safe defaults.
# JANITOR_AI_ENABLED=true

# Optional: require no-training provider policies (fail-closed strict mode)
# Set to "strict" to block free-tier models and require ZDR from providers.
# JANITOR_PRIVACY_MODE=strict

# ── Cloud Provider ─────────────────────────────────────────────────────

# Optional: cloud provider backend
# Options: fixture (default), aws, gcp, azure
# JANITOR_BACKEND=fixture

# Optional: Terraform binary to use
# Options: tflocal (default, targets LocalStack), terraform (targets real AWS)
# TF_CMD=tflocal

# ── Scheduling ─────────────────────────────────────────────────────────

# Optional: cron schedule for automated scans
# Default: disabled
# JANITOR_SCHEDULE=0 6 * * *

# ── LocalStack ─────────────────────────────────────────────────────────

# LocalStack auth token — required to run live audit mode
# Sign up free at https://app.localstack.cloud (Hobby plan, non-commercial use)
LOCALSTACK_AUTH_TOKEN=....

# ── Output ─────────────────────────────────────────────────────────────

# Optional: base directory for all output files (findings, logs, rollbacks, policies)
# Defaults to current working directory when cloud-janitor is invoked
# JANITOR_HOME=/path/to/output

# ── Privacy & Trust ────────────────────────────────────────────────────

# Optional: LLM data retention policy attestation
# In strict mode, must be set to "none" (operator declares endpoint retains no data).
# Default: "unknown"
# JANITOR_LLM_RETENTION_POLICY=none

# Optional: fallback actor identity for sandbox/fixture mode audit stamps
# Default: "system"
# JANITOR_ACTOR=your-name@corp

# ── Health & Timeouts ──────────────────────────────────────────────────

# Optional: skip the backend reachability preflight before audit scans
# Set to "1" to proceed even if LocalStack/AWS is unreachable (useful for dry-run testing)
# JANITOR_SKIP_HEALTH_CHECK=1

# Optional: configurable subprocess/LLM timeouts (seconds)
# Non-positive or non-numeric values fall back to the default. Max 1800s for TF/hook.
# JANITOR_TF_INIT_TIMEOUT=120
# JANITOR_TF_APPLY_TIMEOUT=120
# JANITOR_TF_VALIDATE_TIMEOUT=180
# JANITOR_HOOK_TIMEOUT=30
# JANITOR_LLM_TIMEOUT=30

# ── Run-Scoped Artifacts ───────────────────────────────────────────────

# Optional: number of run-scoped reasoning log files to keep (oldest pruned beyond this)
# Default: 20
# JANITOR_RUN_RETENTION=20

# Optional: number of run-scoped findings store files to keep (oldest pruned beyond this)
# Default: 20
# JANITOR_FINDINGS_RETENTION=20